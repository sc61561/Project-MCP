# Use a real absolute path; quotes allow spaces. This file is shell-compatible.
PROJECT_ROOT="/absolute/path/to/your/project"
# Optional; defaults to 1 MiB. Larger values are capped at 1 MiB.
MAX_READ_BYTES=1048576

# Used by tunnel-client, not by server.py.
CONTROL_PLANE_TUNNEL_ID="tunnel_replace_me"
CONTROL_PLANE_ORGANIZATION_ID="org-replace-me"
# Set CONTROL_PLANE_API_KEY interactively; never commit an actual API key.
